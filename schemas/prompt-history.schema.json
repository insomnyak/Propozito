{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt History",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prompt_id", "timestamp", "source_pre_prompt_path", "refined_prompt_path", "target_ai_coder", "context_paths", "expected_outputs", "status", "outcome"],
        "properties": {
          "prompt_id": { "type": "string" },
          "timestamp": { "type": "string" },
          "source_pre_prompt_path": { "type": "string" },
          "refined_prompt_path": { "type": "string" },
          "target_ai_coder": { "type": "string" },
          "context_paths": { "type": "array", "items": { "type": "string" } },
          "expected_outputs": { "type": "array", "items": { "type": "string" } },
          "commit_sha": { "type": "string" },
          "status": { "type": "string" },
          "outcome": { "type": "string" },
          "lessons_learned": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
