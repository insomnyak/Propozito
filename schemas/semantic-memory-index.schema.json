{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Memory Index",
  "type": "object",
  "required": ["schema_version", "index_id", "canonical_sources", "nodes"],
  "properties": {
    "schema_version": { "type": "string" },
    "index_id": { "type": "string" },
    "canonical_sources": { "type": "array", "items": { "type": "string" } },
    "nodes": { "type": "array", "items": { "$ref": "semantic-memory-node.schema.json" } }
  }
}
