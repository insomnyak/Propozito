{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate Result",
  "type": "object",
  "required": ["gate_id", "task_id", "agent", "timestamp", "status", "inputs_checked", "commands_run", "findings", "routing_decision"],
  "properties": {
    "gate_id": { "type": "string" },
    "task_id": { "type": "string" },
    "agent": { "type": "string" },
    "timestamp": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "fail", "escalated"] },
    "inputs_checked": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "string" } },
    "routing_decision": { "type": "string" }
  }
}
