{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "required": [
    "task_id",
    "story_id",
    "objective",
    "owner_agent",
    "status",
    "requirement_ids",
    "acceptance_criteria_ids",
    "allowed_files",
    "disallowed_files",
    "dependencies",
    "required_tests",
    "required_gates",
    "evidence_requirements",
    "risk_level",
    "human_escalation_triggers"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "story_id": { "type": "string" },
    "objective": { "type": "string" },
    "owner_agent": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "ready", "in_progress", "blocked", "review", "done", "cancelled"] },
    "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance_criteria_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "disallowed_files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "required_tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "rollback_notes": { "type": "string" },
    "human_escalation_triggers": { "type": "array", "items": { "type": "string" } },
    "evidence_path": { "type": "string" },
    "gate_result_paths": { "type": "array", "items": { "type": "string" } },
    "commit_hashes": { "type": "array", "items": { "type": "string" } },
    "no_commit_reason": { "type": "string" }
  }
}
