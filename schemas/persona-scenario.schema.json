{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona Scenario",
  "type": "object",
  "required": ["persona_id", "role", "technical_level", "permissions", "device_context", "primary_goal", "happy_path", "edge_path", "failure_path", "accessibility_considerations", "expected_evidence"],
  "properties": {
    "persona_id": { "type": "string" },
    "role": { "type": "string" },
    "technical_level": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "device_context": { "type": "string" },
    "primary_goal": { "type": "string" },
    "secondary_goal": { "type": "string" },
    "happy_path": { "type": "array", "items": { "type": "string" } },
    "edge_path": { "type": "array", "items": { "type": "string" } },
    "failure_path": { "type": "array", "items": { "type": "string" } },
    "accessibility_considerations": { "type": "array", "items": { "type": "string" } },
    "expected_evidence": { "type": "array", "items": { "type": "string" } }
  }
}
