{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epic",
  "type": "object",
  "required": ["epic_id", "title", "product_goal", "user_value", "non_goals", "target_personas", "included_stories", "risks", "dependencies", "success_metrics", "required_gates"],
  "properties": {
    "epic_id": { "type": "string" },
    "title": { "type": "string" },
    "product_goal": { "type": "string" },
    "user_value": { "type": "string" },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "target_personas": { "type": "array", "items": { "type": "string" } },
    "included_stories": { "type": "array", "items": { "type": "string" } },
    "excluded_scope": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "success_metrics": { "type": "array", "items": { "type": "string" } },
    "required_gates": { "type": "array", "items": { "type": "string" } }
  }
}
