{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traceability Matrix",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "acceptance_criterion_id", "task_id", "implementation_files", "test_files", "test_command", "evidence_report", "gate_result", "persona_qa_result"],
        "properties": {
          "requirement_id": { "type": "string" },
          "acceptance_criterion_id": { "type": "string" },
          "task_id": { "type": "string" },
          "implementation_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "test_files": { "type": "array", "items": { "type": "string" } },
          "test_command": { "type": "string" },
          "evidence_report": { "type": "string" },
          "gate_result": { "type": "string" },
          "persona_qa_result": { "type": "string" },
          "exemption": { "type": "string" }
        }
      }
    }
  }
}
