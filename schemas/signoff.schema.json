{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signoff",
  "type": "object",
  "required": ["schema_version", "signoffs"],
  "properties": {
    "schema_version": { "type": "string" },
    "signoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signoff_id", "feature_id", "work_item_id", "verification_surface_id", "owner_status", "signed_by", "signed_at"],
        "properties": {
          "signoff_id": { "type": "string" },
          "feature_id": { "type": "string" },
          "work_item_id": { "type": "string" },
          "verification_surface_id": { "type": "string" },
          "owner_status": { "type": "string", "enum": ["accepted", "rejected", "deferred", "not_required"] },
          "signed_by": { "type": "string" },
          "owner_note": { "type": "string" },
          "signed_at": { "type": "string" }
        }
      }
    }
  }
}
