{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implementation Map",
  "type": "object",
  "required": ["schema_version", "subsystems"],
  "properties": {
    "schema_version": { "type": "string" },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subsystem_id", "purpose", "owned_files", "adjacent_files", "key_tests", "runtime_routes", "data_owned", "state_owned", "external_dependencies", "security_boundaries", "current_status", "known_risks", "last_verified_at"],
        "properties": {
          "subsystem_id": { "type": "string" },
          "purpose": { "type": "string" },
          "owned_files": { "type": "array", "items": { "type": "string" } },
          "adjacent_files": { "type": "array", "items": { "type": "string" } },
          "key_tests": { "type": "array", "items": { "type": "string" } },
          "runtime_routes": { "type": "array", "items": { "type": "string" } },
          "data_owned": { "type": "array", "items": { "type": "string" } },
          "state_owned": { "type": "array", "items": { "type": "string" } },
          "external_dependencies": { "type": "array", "items": { "type": "string" } },
          "security_boundaries": { "type": "array", "items": { "type": "string" } },
          "current_status": { "type": "string" },
          "known_risks": { "type": "array", "items": { "type": "string" } },
          "last_verified_at": { "type": "string" }
        }
      }
    }
  }
}
