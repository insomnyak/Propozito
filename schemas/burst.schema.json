{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Burst",
  "type": "object",
  "required": ["burst_id", "task_id", "objective", "allowed_files", "disallowed_files", "planned_tests", "evidence_plan", "required_gates", "max_files_changed"],
  "properties": {
    "burst_id": { "type": "string" },
    "task_id": { "type": "string" },
    "objective": { "type": "string" },
    "allowed_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "disallowed_files": { "type": "array", "items": { "type": "string" } },
    "planned_tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_plan": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "max_files_changed": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}
