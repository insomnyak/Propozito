{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Memory Node",
  "type": "object",
  "required": ["node_id", "source_artifact", "source_path", "source_kind", "text_for_embedding", "content_hash", "last_indexed_at"],
  "properties": {
    "node_id": { "type": "string" },
    "source_artifact": { "type": "string" },
    "source_path": { "type": "string" },
    "source_kind": { "type": "string" },
    "canonical_graph_node_id": { "type": "string" },
    "text_for_embedding": { "type": "string" },
    "embedding_provider": { "type": "string" },
    "embedding_model": { "type": "string" },
    "embedding_dimensions": { "type": "integer" },
    "embedding_vector_ref": { "type": "string" },
    "content_hash": { "type": "string" },
    "last_indexed_at": { "type": "string" }
  }
}
