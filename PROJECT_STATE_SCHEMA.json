{ "$schema": "http://json-schema.org/draft-07/schema#", "title": "Project State Schema", "description": "Schema for the central PROJECT_STATE.json file in the Propozito Orchestrator.", "type": "object", "properties": { "project_metadata": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "owner": { "type": "string" }, "current_phase": { "type": "string" }, "status": { "type": "string" } }, "required": ["name", "description", "owner", "current_phase", "status"] }, "goals_and_features": { "type": "object", "properties": { "project_purpose_contract": { "type": "string", "format": "uri-reference" }, "feature_goal_contracts": { "type": "array", "items": { "type": "string", "format": "uri-reference" } } }, "required": ["project_purpose_contract", "feature_goal_contracts"] }, "agents_status": { "type": "array", "items": { "type": "object", "properties": { "agent_name": { "type": "string" }, "current_task": { "type": "string" }, "status": { "type": "string" }, "last_update": { "type": "string", "format": "date-time" } }, "required": ["agent_name", "current_task", "status", "last_update"] } }, "artifacts": { "type": "object", "properties": { "codebase": { "type": "string", "format": "uri-reference" }, "documentation": { "type": "array", "items": { "type": "string", "format": "uri-reference" } }, "test_reports": { "type": "array", "items": { "type": "string", "format": "uri-reference" } }, "security_reports": { "type": "array", "items": { "type": "string", "format": "uri-reference" } }, "deployment_artifacts": { "type": "array", "items": { "type": "string", "format": "uri-reference" } } } }, "integrity_log": { "type": "array", "items": { "type": "object", "properties": { "timestamp": { "type": "string", "format": "date-time" }, "task_id": { "type": "string" }, "auditor_agent": { "type": "string" }, "result": { "type": "string", "enum": ["pass", "fail", "escalated"] }, "report_reference": { "type": "string", "format": "uri-reference" } }, "required": ["timestamp", "task_id", "auditor_agent", "result", "report_reference"] } }, "human_intervention_log": { "type": "array", "items": { "type": "object", "properties": { "timestamp": { "type": "string", "format": "date-time" }, "escalation_reason": { "type": "string" }, "owner_decision": { "type": "string" }, "agent_involved": { "type": "string" } }, "required": ["timestamp", "escalation_reason", "owner_decision", "agent_involved"] } } } }
